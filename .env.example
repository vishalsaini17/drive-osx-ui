# Base path for the platform API.
# In Docker the UI is served behind nginx, which proxies /api/v1 to the API
# container, so a relative path is correct in every environment.
VITE_API_BASE_URL="/api/v1"

# STUN server(s) OSX Meet's WebRTC peer connections use for NAT traversal,
# comma-separated. Falls back to Google's public STUN server when unset —
# fine for development, but a production deployment behind restrictive NATs
# will also need a TURN server here.
VITE_STUN_URLS="stun:stun.l.google.com:19302"
